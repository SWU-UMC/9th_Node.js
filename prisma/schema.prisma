// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique(map: "email") @db.VarChar(255)
  name          String   @db.VarChar(100)
  gender        String   @db.VarChar(15)
  birth         DateTime @db.Date
  address       String   @db.VarChar(255)
  detailAddress String?  @map("detail_address") @db.VarChar(255)
  phoneNumber   String   @map("phone_number") @db.VarChar(15)
  point         Int      @default(0)

  userFavorCategories UserFavorCategory[]
  reviews             Review[] 
  userMissions        UserMission[] 

  @@map("user")
}

model Restaurant {
  id              Int          @id @default(autoincrement())
  name            String       @db.VarChar(100)
  address         String       @db.VarChar(255)
  detailAddress   String?      @map("detail_address") @db.VarChar(255)
  phoneNumber     String       @map("phone_number") @db.VarChar(15)

  region          Region       @relation(fields: [regionId], references: [id])
  regionId        Int          @map("region_id")
  foodCategory    FoodCategory @relation(fields: [foodCategoryId], references: [id])
  foodCategoryId  Int          @map("food_category_id")

  reviews         Review[]
  missions        Mission[]

  @@map("restaurant")
}

model Region {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(100)

  restaurants Restaurant[]
  
  @@map("region")
}

model Review {
  id      Int    @id @default(autoincrement())
  content String @db.VarChar(100)
  rating  Float  @db.Float

  user         User       @relation(fields: [userId], references: [id])
  userId       Int        @map("user_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId Int        @map("restaurant_id")

  @@map("review")
}

model FoodCategory {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(100)

  userFavorCategories UserFavorCategory[]
  restaurants         Restaurant[]

  @@map("food_category")
}

model UserFavorCategory {
  id             Int          @id @default(autoincrement())

  user           User         @relation(fields: [userId], references: [id])
  userId         Int          @map("user_id")
  foodCategory   FoodCategory @relation(fields: [foodCategoryId], references: [id])
  foodCategoryId Int          @map("food_category_id")

  @@index([foodCategoryId], map: "f_category_id")
  @@index([userId], map: "user_id")
  @@map("user_favor_category")
}

model Mission {
  id        Int      @id @default(autoincrement())
  point     Int
  content   String   @db.Text
  deadline  DateTime? @db.Date

  restaurant    Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId  Int        @map("restaurant_id")
  userMissions  UserMission[]

  @@map("mission")
}

model UserMission {
  id        Int      @id @default(autoincrement())
  status    String   @default("진행중") @db.VarChar(20)

  user      User     @relation(fields: [userId], references: [id])
  userId    Int      @map("user_id")
  mission   Mission  @relation(fields: [missionId], references: [id])
  missionId Int      @map("mission_id")

  @@unique([userId, missionId])
  @@map("user_mission")
}
